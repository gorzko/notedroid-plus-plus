        <item name="colorPrimary">@color/npp_blue</item>
        <item name="colorPrimaryDark">@color/npp_blue_dark</item>
        <item name="colorSecondary">@color/npp_orange</item>
        <item name="android:colorBackground">@color/app_bg_light</item>
