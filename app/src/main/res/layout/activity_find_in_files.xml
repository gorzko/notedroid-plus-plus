<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <EditText
        android:id="@+id/fif_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/find_what"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionSearch" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/fif_match_case"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_case" />

        <CheckBox
            android:id="@+id/fif_whole_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_whole_word" />

        <CheckBox
            android:id="@+id/fif_regex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/use_regex" />
    </LinearLayout>

    <Button
        android:id="@+id/fif_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_find_in_files" />

    <ProgressBar
        android:id="@android:id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <ListView
        android:id="@+id/fif_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
