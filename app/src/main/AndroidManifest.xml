<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoteDroidPlusPlus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".preview.PreviewActivity"
            android:exported="false"
            android:label="@string/preview_html"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/menu_settings"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".plugins.PluginImportActivity"
            android:exported="false"
            android:label="@string/plugin_import"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".files.FindInFilesActivity"
            android:exported="false"
            android:label="@string/action_find_in_files"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
