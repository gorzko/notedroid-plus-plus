<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreferenceCompat
        app:key="show_line_numbers"
        app:title="Show line numbers"
        app:defaultValue="true" />
    <SwitchPreferenceCompat
        app:key="wrap_lines"
        app:title="Wrap lines"
        app:defaultValue="false" />
    <SeekBarPreference
        app:key="font_size"
        app:title="Editor font size (sp)"
        app:defaultValue="14"
        app:min="8"
        android:max="40" />
    <ListPreference
        app:key="app_language"
        app:title="@string/pref_language"
        app:defaultValue=""
        app:entries="@array/language_display_names"
        app:entryValues="@array/language_tags" />
    <ListPreference
        app:key="theme_name"
        app:title="@string/pref_theme"
        app:defaultValue="Default"
        app:entries="@array/theme_names"
        app:entryValues="@array/theme_names" />
</PreferenceScreen>
